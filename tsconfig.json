{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // The harness and tests drive mermaid's API and puppeteer, whose types name DOM classes
    // (`Element` in `render`, `HTMLElement` in `mount`). Plugin packages stay without DOM.
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": ["test", "harness", "vitest.config.ts", "eslint.config.js"],
  "exclude": ["harness/out"]
}
