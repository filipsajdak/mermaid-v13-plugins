{
  "name": "mermaid-v13-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "Unofficial community diagram plugins for the Mermaid v13 alpha: C4, BPMN and swimlanes.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "render": "node harness/render.mjs",
    "sheet": "node harness/sheet.mjs",
    "serve": "node harness/serve.mjs",
    "smoke": "node harness/smoke.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm lint && pnpm format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mermaid-js/core": "13.0.0-alpha.1",
    "@mermaid-v13-plugins/diagram-bpmn": "workspace:*",
    "@mermaid-v13-plugins/diagram-c4": "workspace:*",
    "@mermaid-v13-plugins/diagram-swimlane": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "mermaid": "13.0.0-alpha.1",
    "prettier": "3.9.10",
    "puppeteer-core": "25.16.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
