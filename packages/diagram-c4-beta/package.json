{
  "name": "@mermaid-v13-plugins/diagram-c4-beta",
  "version": "0.0.0",
  "private": true,
  "description": "Unofficial Mermaid v13 plugin for c4-beta, the compact Structurizr-style C4 syntax.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./detector": {
      "types": "./dist/detector.d.ts",
      "default": "./dist/detector.js"
    },
    "./language": {
      "types": "./dist/language.d.ts",
      "default": "./dist/language.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@mermaid-js/core": "13.0.0-alpha.1"
  },
  "devDependencies": {
    "@mermaid-js/core": "13.0.0-alpha.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  }
}
